# ---- Stripe (use TEST keys while developing) ----
# Get these from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_xxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# Webhook signing secret (stripe listen / dashboard). Optional for local click-through.
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Public base URL of THIS site (no trailing slash). Production: https://luumora.online
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ---- Meta Pixel (optional, legitimate conversion tracking) ----
# Leave blank to disable. When set, fires PageView / InitiateCheckout / Purchase.
NEXT_PUBLIC_META_PIXEL_ID=

# Secret used to sign download tokens (any long random string)
DOWNLOAD_SECRET=change-me-to-a-long-random-string

# Member platform link. Leave blank to use the built-in /plattform (Luumora Akademi).
NEXT_PUBLIC_LUMORA_PLATFORM_URL=

# ---- Members platform (Luumora Akademi) ----
# Upstash Redis stores member accounts. Create a free DB at upstash.com.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Signs login sessions — any long random string.
SESSION_SECRET=change-me-to-a-long-random-string
